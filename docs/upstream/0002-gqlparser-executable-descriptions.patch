diff --git a/parser/schema.go b/parser/schema.go
index 7152963..eb77d94 100644
--- a/parser/schema.go
+++ b/parser/schema.go
@@ -636,3 +636,12 @@ type descriptionWithComment struct {
 	text    string
 	comment *CommentGroup
 }
+
+// commentOr returns the comment that preceded the description, falling back to
+// the parser's pending comment when there was no description.
+func (d descriptionWithComment) commentOr(fallback *CommentGroup) *CommentGroup {
+	if d.comment != nil {
+		return d.comment
+	}
+	return fallback
+}
