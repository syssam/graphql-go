+// readEscapedUnicode decodes the EscapedUnicode production beginning at the
+// backslash under s.end, returning the Unicode scalar value and the number of
+// bytes it spans (counting the leading backslash and "u").
+//
+// Two forms are accepted, per specification section 2.1.7: a braced form
+// holding one scalar value, and the four-digit form, which may also be the
+// leading half of a surrogate pair.
+//
+// A value in the surrogate range is not a Unicode scalar value. Alone it is a
+// syntax error; only a leading surrogate immediately followed by a trailing
+// one is valid, and the pair decodes to a supplementary character. Passing a
+// surrogate to buf.WriteRune silently yields U+FFFD, so rejecting it here is
+// what stops a malformed escape reaching the caller as ordinary data.
+func (s *Lexer) readEscapedUnicode(inputLen int) (rune, int, bool) {
+	if s.end+2 < inputLen && s.Input[s.end+2] == '{' {
+		closing := strings.IndexByte(s.Input[s.end+3:], '}')
+		if closing <= 0 || closing > 8 {
+			return 0, 0, false
+		}
+		r, ok := unhex(s.Input[s.end+3 : s.end+3+closing])
+		if !ok || !isUnicodeScalarValue(r) {
+			return 0, 0, false
+		}
+		return r, closing + 4, true
+	}
+
+	if s.end+6 > inputLen {
+		return 0, 0, false
+	}
+	r, ok := unhex(s.Input[s.end+2 : s.end+6])
+	if !ok {
+		return 0, 0, false
+	}
+	if isLeadingSurrogate(r) {
+		if s.end+12 > inputLen || s.Input[s.end+6] != '\\' || s.Input[s.end+7] != 'u' {
+			return 0, 0, false
+		}
+		trailing, ok := unhex(s.Input[s.end+8 : s.end+12])
+		if !ok || !isTrailingSurrogate(trailing) {
+			return 0, 0, false
+		}
+		return (r-0xD800)*0x400 + (trailing - 0xDC00) + 0x10000, 12, true
+	}
+	if isTrailingSurrogate(r) {
+		return 0, 0, false
+	}
+	return r, 6, true
+}
+
+func isLeadingSurrogate(r rune) bool  { return r >= 0xD800 && r <= 0xDBFF }
+func isTrailingSurrogate(r rune) bool { return r >= 0xDC00 && r <= 0xDFFF }
+
+func isUnicodeScalarValue(r rune) bool {
+	return (r >= 0 && r <= 0xD7FF) || (r >= 0xE000 && r <= 0x10FFFF)
+}
