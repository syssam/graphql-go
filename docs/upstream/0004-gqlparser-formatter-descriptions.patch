+package formatter_test
+
+import (
+	"bytes"
+	"strconv"
+	"testing"
+
+	"github.com/vektah/gqlparser/v2"
+	"github.com/vektah/gqlparser/v2/ast"
+	"github.com/vektah/gqlparser/v2/formatter"
+)
+
+// Every description must survive FormatSchema followed by LoadSchema
+// unchanged. A block string cannot hold every string: it strips leading and
+// trailing blank lines and the indentation common to every line, and """ ends
+// it unless escaped.
+var roundTripDescriptions = []struct{ name, desc string }{
+	{"plain", "plain text"},
+	{"multi line", "line one\n  indented two"},
+	{"triple quote", `say """ to quote`},
+	{"escaped triple quote", `a \""" stays`},
+	{"trailing quote", `ends with "`},
+	{"trailing backslash", `ends with \`},
+	{"leading space", "  leading spaces"},
+	{"every line indented", "  one\n    two"},
+	{"leading blank line", "\nafter a blank line"},
+	{"leading whitespace line", "   \nafter a whitespace line"},
+	{"trailing newline", "trailing newline\n"},
+	{"carriage return", "one\rtwo"},
+	{"tab", "a\tb"},
+}
+
+func TestFormatSchema_DescriptionRoundTrip(t *testing.T) {
+	for _, tc := range roundTripDescriptions {
+		t.Run(tc.name, func(t *testing.T) {
+			sdl := "type Query {\n  " + strconv.Quote(tc.desc) + "\n  f: Int\n}\n"
+			got := reformat(t, sdl).Types["Query"].Fields.ForName("f").Description
+			if got != tc.desc {
+				t.Errorf("description = %q, want %q", got, tc.desc)
+			}
+		})
+	}
+}
+
+func TestFormatSchema_SchemaDescription(t *testing.T) {
+	for _, tc := range []struct {
+		name, sdl  string
+		directives int
+	}{
+		{"default root names", "\"root\"\nschema { query: Query }\ntype Query { f: Int }\n", 0},
+		{"custom root names", "\"root\"\nschema { query: Q }\ntype Q { f: Int }\n", 0},
+		{
+			"schema directive",
+			"directive @d on SCHEMA\n\"root\"\nschema @d { query: Query }\ntype Query { f: Int }\n",
+			1,
+		},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			s := reformat(t, tc.sdl)
+			if s.Description != "root" {
+				t.Errorf("schema description = %q, want %q", s.Description, "root")
+			}
+			if len(s.SchemaDirectives) != tc.directives {
+				t.Errorf("schema directives = %d, want %d", len(s.SchemaDirectives), tc.directives)
+			}
+		})
+	}
+}
+
+func reformat(t *testing.T, sdl string) *ast.Schema {
+	t.Helper()
+	s, err := gqlparser.LoadSchema(&ast.Source{Name: "in.graphql", Input: sdl})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var buf bytes.Buffer
+	formatter.NewFormatter(&buf).FormatSchema(s)
+	again, err := gqlparser.LoadSchema(&ast.Source{Name: "out.graphql", Input: buf.String()})
+	if err != nil {
+		t.Fatalf("formatted schema does not load: %v\n%s", err, buf.String())
+	}
+	return again
+}
