+// printableAsBlockString reports whether s reads back unchanged from the block
+// string WriteDescription writes. That block starts its content on the line
+// after the opening quotes, so every line takes part in removing the common
+// indentation, and a block string also drops leading and trailing blank lines
+// and normalizes line terminators.
+func printableAsBlockString(s string) bool {
+	lines := strings.Split(s, "\n")
+	if isBlank(lines[0]) || isBlank(lines[len(lines)-1]) {
+		return false
+	}
+	commonIndent := true
+	for _, line := range lines {
+		for _, r := range line {
+			if r < ' ' && r != '\t' || r == 0x7f {
+				return false
+			}
+		}
+		if !isBlank(line) && line[0] != ' ' && line[0] != '\t' {
+			commonIndent = false
+		}
+	}
+	return !commonIndent
+}
+
+func isBlank(line string) bool {
+	return strings.Trim(line, " \t") == ""
+}
+
+// quoteString writes s as a GraphQL string value. strconv.Quote is not one:
+// it can emit \x, \a, \v and \U escapes, none of which GraphQL accepts.
+func quoteString(s string) string {
+	var sb strings.Builder
+	sb.WriteByte('"')
+	for _, r := range s {
+		switch r {
+		case '"':
+			sb.WriteString(`\"`)
+		case '\\':
+			sb.WriteString(`\\`)
+		case '\n':
+			sb.WriteString(`\n`)
+		case '\r':
+			sb.WriteString(`\r`)
+		case '\t':
+			sb.WriteString(`\t`)
+		case '\b':
+			sb.WriteString(`\b`)
+		case '\f':
+			sb.WriteString(`\f`)
+		default:
+			if r < ' ' || r == 0x7f {
+				fmt.Fprintf(&sb, `\u%04X`, r)
+			} else {
+				sb.WriteRune(r)
+			}
+		}
+	}
+	sb.WriteByte('"')
+	return sb.String()
+}
