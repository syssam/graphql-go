[
  {"name": "scalar and alias", "query": "{ a: str str }"},
  {"name": "nullable field error", "query": "{ failNullable }"},
  {"name": "non-null field error bubbles to root", "query": "{ failNonNull }"},
  {"name": "non-null error under nullable parent", "query": "{ nullableObj { failNonNull } }"},
  {"name": "sibling survives a nullable error", "query": "{ failNullable str }"},
  {"name": "list with a nullable element error", "query": "{ listNullableElems }"},
  {"name": "list with a non-null element error", "query": "{ listNonNullElems }"},
  {"name": "nested list error path", "query": "{ grid }"},
  {"name": "null from a non-null resolver", "query": "{ nullFromNonNull }"},
  {"name": "typename on an object", "query": "{ __typename }"},
  {"name": "typename on an interface", "query": "{ node { __typename id } }"},
  {"name": "inline fragment on the wrong type", "query": "{ node { ... on Other { id } id } }"},
  {"name": "skip true", "query": "{ str @skip(if: true) other: str }"},
  {"name": "include false", "query": "{ str @include(if: false) other: str }"},
  {"name": "skip via variable", "query": "query($s: Boolean!){ str @skip(if: $s) other: str }", "variables": {"s": true}},
  {"name": "argument default applies", "query": "{ withDefault }"},
  {"name": "argument explicit null", "query": "{ withDefault(v: null) }"},
  {"name": "variable omitted, argument default applies", "query": "query($v: String){ withDefault(v: $v) }", "variables": {}},
  {"name": "variable explicitly null", "query": "query($v: String){ withDefault(v: $v) }", "variables": {"v": null}},
  {"name": "unknown field", "query": "{ nope }"},
  {"name": "unknown argument", "query": "{ str(nope: 1) }"},
  {"name": "wrong variable type", "query": "query($n: Int!){ intArg(v: $n) }", "variables": {"n": "no"}},
  {"name": "missing required variable", "query": "query($n: Int!){ intArg(v: $n) }", "variables": {}},
  {"name": "null for a non-null variable", "query": "query($n: Int!){ intArg(v: $n) }", "variables": {"n": null}},
  {"name": "unused variable", "query": "query($n: Int!){ str }", "variables": {"n": 1}},
  {"name": "Int out of 32-bit range", "query": "{ intArg(v: 2147483648) }"},
  {"name": "Float given an Int", "query": "{ floatArg(v: 5) }"},
  {"name": "ID given an Int", "query": "{ idArg(v: 5) }"},
  {"name": "ID given a Float", "query": "{ idArg(v: 1.5) }"},
  {"name": "enum value unknown", "query": "{ enumArg(v: NOPE) }"},
  {"name": "enum given a string literal", "query": "{ enumArg(v: \"RED\") }"},
  {"name": "input object missing a required field", "query": "{ inputArg(v: {}) }"},
  {"name": "input object unknown field", "query": "{ inputArg(v: {n: 1, nope: 2}) }"},
  {"name": "list coercion from a single value", "query": "query($l: [Int]){ listArg(v: $l) }", "variables": {"l": 5}},
  {"name": "two errors in one request", "query": "{ failNullable other: failNullable }"},
  {"name": "duplicate field merging", "query": "{ str str }"},
  {"name": "fragment merging", "query": "{ ...F ...F } fragment F on Query { str }"},
  {"name": "empty selection on an object", "query": "{ nullableObj { __typename } }"},
  {"name": "mutation runs", "query": "mutation { bump }"},
  {"name": "parse failure", "query": "{"},
  {"name": "anonymous plus named operation", "query": "{ str } query Named { str }"}
]
